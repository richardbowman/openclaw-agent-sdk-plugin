#!/bin/sh
# Launcher for http-server.mjs — called by OpenClaw localService.
#
# OpenClaw spawns this with stdio:ignore, so all output would be lost without
# the redirect below.  We log to a file so the server's startup/request logs
# are inspectable:
#   ssh root@<HA-IP> "tail -f /addon_configs/17e0cc66_openclaw_assistant/claude-sdk-proxy/http-server.log"
#
# Note: exec replaces this shell with node, so the shell itself uses no memory
# after the node process starts.  The final echo line is unreachable on success.
LOG=/config/claude-sdk-proxy/http-server.log
echo "[$(date)] start-http-server invoked, PATH=$PATH" >> $LOG
which node >> $LOG 2>&1
node --version >> $LOG 2>&1
# --max-old-space-size caps the V8 heap so Node throws a catchable JS heap
# error before the container OOM killer fires (which is silent / SIGKILL).
# 512 MB is comfortable for normal use; bump if you see heap-limit errors.
exec node --max-old-space-size=512 /config/claude-sdk-proxy/http-server.mjs >> $LOG 2>&1
echo "[$(date)] exec node failed (exit $?)" >> $LOG
